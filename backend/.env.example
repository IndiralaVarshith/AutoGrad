# =========================================================
# AutoGrade Backend — Environment Configuration (.env)
# =========================================================

# 1. AI Provider Selection: 'ollama' (default local) or 'gemini' (cloud API)
AI_PROVIDER=ollama
LOCAL_FIRST=true

# 2. Local Ollama Models (discovered from /api/tags, /api/show, and /api/ps)
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_SIMPLE_MODEL=qwen3.5:4b
OLLAMA_COMPLEX_MODEL=gemma4:e4b
# Reads question paper scans. If it is not installed the upload fails clearly;
# it never switches to another local model. Defaults to OLLAMA_COMPLEX_MODEL.
OLLAMA_PAPER_READER_MODEL=gemma4:e4b
OLLAMA_SHEET_READER_MODEL=qwen3.5:4b
OLLAMA_GRADER_MODEL=gemma4:e4b
OLLAMA_MAX_CONCURRENT_REQUESTS=1
OLLAMA_CONTEXT_WINDOW=4096
OLLAMA_DISCOVERY_CACHE_SECONDS=30
OLLAMA_LOW_COMPLEXITY_MODELS=qwen3.5:4b
OLLAMA_MEDIUM_COMPLEXITY_MODELS=qwen3.5:4b
OLLAMA_HIGH_COMPLEXITY_MODELS=gemma4:e4b
OLLAMA_CRITICAL_VALIDATION_MODELS=gemma4:e4b
# Optional capability overrides apply only when /api/show lacks metadata.
OLLAMA_VISION_MODELS=
OLLAMA_REASONING_MODELS=

# 3. Gemini fallback and selective independent verification.
# Keys are empty here; put authorized values only in ignored backend/.env.
GEMINI_ENABLED=true
GEMINI_FALLBACK_ENABLED=true
GEMINI_VERIFICATION_ENABLED=true
GEMINI_VERIFICATION_SAMPLE_RATE=0.05
GEMINI_API_KEY_1=
# Set each authorization flag to true only with that key owner's permission.
GEMINI_KEY_1_OWNER_AUTHORIZED=false
GEMINI_API_KEY_2=
GEMINI_KEY_2_OWNER_AUTHORIZED=false
GEMINI_API_KEY_3=
GEMINI_KEY_3_OWNER_AUTHORIZED=false
# Legacy single-key variable remains supported when numbered keys are absent.
GEMINI_API_KEY=
GEMINI_LEGACY_KEY_OWNER_AUTHORIZED=false
GEMINI_CREDENTIAL_PRIORITY=legacy,1,2
GEMINI_MODEL=gemini-3.5-flash-lite
# Which entry in this file holds the one key the app uses.
GEMINI_KEY_ENV_NAME=GEMINI_API_KEY
GEMINI_MODEL_PRIORITY=gemini-3.8-flash
# Per-category priorities. Critical validation favors the Pro model, then
# falls back only to discovered models that meet the requested capabilities.
GEMINI_LOW_COMPLEXITY_MODELS=gemini-3.8-flash
GEMINI_MEDIUM_COMPLEXITY_MODELS=gemini-3.8-flash
GEMINI_HIGH_COMPLEXITY_MODELS=gemini-3.8-flash
GEMINI_CRITICAL_VALIDATION_MODELS=gemini-3.1-pro-preview,gemini-3.8-flash
# Model-list access is validated per key; the explicit feature allowlists below
# are based on Gemini model documentation because Model metadata omits them.
GEMINI_VISION_MODELS=gemini-3.8-flash,gemini-3.1-pro-preview
GEMINI_STRUCTURED_JSON_MODELS=gemini-3.8-flash,gemini-3.1-pro-preview
GEMINI_REASONING_MODELS=gemini-3.8-flash,gemini-3.1-pro-preview
GEMINI_EMBEDDING_MODEL=gemini-embedding-2
GEMINI_EMBEDDING_DIMENSIONS=768
GEMINI_MAX_RETRIES=1
GEMINI_MAX_RETRY_WAIT_SECONDS=30
GEMINI_QUOTA_COOLDOWN_SECONDS=60
GEMINI_MAX_CONCURRENT_REQUESTS=1
GEMINI_PROVIDER_STATE_FILE=/tmp/autograde_gemini_provider_state.json

# 4. Teacher-validated OCR data. Disabled until retention and access policy
# are configured. Use a private, stable random salt; never use student IDs as
# plain writer identifiers.
HANDWRITING_DATASET_ENABLED=false
HANDWRITING_DATASET_RETENTION_DAYS=0
HANDWRITING_DATASET_SALT=
HANDWRITING_DATASET_ACCESS_POLICY_CONFIRMED=false
HANDWRITING_DATASET_TTL_ENFORCED=false
HANDWRITING_DATASET_VERSION=v1

# 5. Firebase Configuration
# Option A (Recommended): Place your downloaded service account JSON at:
#   backend/firebase-service-account.json
# AutoGrade automatically auto-detects this file, extracts project_id,
# and configures the storage bucket.
FIREBASE_SERVICE_ACCOUNT=./firebase-service-account.json

# Option B: Explicit project ID and custom storage bucket (if different from default <project_id>.appspot.com)
# FIREBASE_PROJECT_ID=your-firebase-project-id
# FIREBASE_STORAGE_BUCKET=your-firebase-project-id.appspot.com
OLLAMA_ENABLE_THINKING=false
