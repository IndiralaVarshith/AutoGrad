# =========================================================
# AutoGrade Backend — Environment Configuration (.env)
# =========================================================

# 1. AI Provider Selection: 'ollama' (default local) or 'gemini' (cloud API)
AI_PROVIDER=ollama

# 2. Local Ollama Dual-Model Configuration (Inference on 127.0.0.1:11434)
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_SIMPLE_MODEL=qwen3.5:4b
OLLAMA_COMPLEX_MODEL=gemma4:e4b
OLLAMA_MAX_CONCURRENT_REQUESTS=1

# 3. Gemini Cloud Configuration (Optional, preserved for fallback/switch)
GEMINI_ENABLED=false
GEMINI_FALLBACK_ENABLED=false
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.8-flash

# 4. Firebase Configuration
# Option A (Recommended): Place your downloaded service account JSON at:
#   backend/firebase-service-account.json
# AutoGrade automatically auto-detects this file, extracts project_id,
# and configures the storage bucket.
FIREBASE_SERVICE_ACCOUNT=./firebase-service-account.json

# Option B: Explicit project ID and custom storage bucket (if different from default <project_id>.appspot.com)
# FIREBASE_PROJECT_ID=your-firebase-project-id
# FIREBASE_STORAGE_BUCKET=your-firebase-project-id.appspot.com
