# =========================================================
# AutoGrade Backend — Environment Configuration (.env)
# =========================================================

# 1. Gemini 2.0 Flash API Key (Required for grading, OCR & RAG)
GEMINI_API_KEY=your_gemini_api_key_here

# 2. Firebase Configuration (Optional for local dev, Required for production)
FIREBASE_PROJECT_ID=autograde-dev
FIREBASE_STORAGE_BUCKET=autograde-dev.appspot.com

# Path to service account JSON (optional if using ADC or local mock)
# FIREBASE_SERVICE_ACCOUNT=./serviceAccountKey.json
