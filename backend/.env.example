# =========================================================
# AutoGrade Backend: environment settings. Copy to backend/.env
# =========================================================

# 1. Gemini does all the AI work. Free tier: do not send real student data (see README).
GEMINI_API_KEY=
# Which entry in this file holds the one key the app uses.
GEMINI_KEY_ENV_NAME=GEMINI_API_KEY
GEMINI_MODEL=gemini-3.1-flash-lite
# Stronger model for second opinions on flagged answers. Empty switches it off.
GEMINI_REVIEW_MODEL=gemini-3.8-flash
GEMINI_REVIEW_ENABLED=false

# Everyone signs in with this one password. Nothing works until it is set.
TEACHER_PASSWORD=
# Largest single file, and largest whole upload.
MAX_UPLOAD_MB=18
MAX_REQUEST_MB=500

# 2. Request budget. Stay under the limits AI Studio shows for your model.
GEMINI_RPM_LIMIT=12
GEMINI_TPM_LIMIT=200000
GEMINI_RPD_LIMIT=500
GEMINI_REVIEW_RPD_LIMIT=20
GEMINI_RUN_CALL_CAP=100
GEMINI_REVIEW_CALL_CAP=15

# 3. What goes to the teacher.
GEMINI_MIN_CONFIDENCE=0.8
GEMINI_HIGH_VALUE_MARKS=5

# 4. Teacher-validated OCR data. Disabled until retention and access policy
# are configured. Use a private, stable random salt; never use student IDs as
# plain writer identifiers.
HANDWRITING_DATASET_ENABLED=false
HANDWRITING_DATASET_RETENTION_DAYS=0
HANDWRITING_DATASET_SALT=
HANDWRITING_DATASET_ACCESS_POLICY_CONFIRMED=false
HANDWRITING_DATASET_TTL_ENFORCED=false
HANDWRITING_DATASET_VERSION=v1

# 5. Firebase Configuration
# Option A (Recommended): Place your downloaded service account JSON at:
#   backend/firebase-service-account.json
# AutoGrade automatically auto-detects this file, extracts project_id,
# and configures the storage bucket.
FIREBASE_SERVICE_ACCOUNT=./firebase-service-account.json

# Option B: Explicit project ID and custom storage bucket (if different from default <project_id>.appspot.com)
# FIREBASE_PROJECT_ID=your-firebase-project-id
# FIREBASE_STORAGE_BUCKET=your-firebase-project-id.appspot.com
